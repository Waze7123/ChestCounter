  "narrative": {
    "northStar": "The Loot Ledger",
    "overview": "A warm-black ledger in which gold is the only voice. The chest count leads every view in large condensed numerals; everything else is quiet, tinted context drawn on one flat ground and divided by hairlines rather than boxed into cards. The signature device is the loot strip: a match drawn as a timeline with one gold diamond per chest.\n\nThe app is native WinForms painted by hand in GDI+ (DPI mode DpiUnawareGdiScaled, so sizes below are authored at 96 DPI and scaled by the system). Density is compact on purpose: it sits beside a game and must not steal space or attention. Motion is short and eased (ease-out expo): the count rolls up, bars grow, hover fades in.",
    "keyCharacteristics": [
      "One flat warm-black ground; depth by tone (rail, surface, hover), never shadow.",
      "Gold carries selection, the count, the primary action and the chest marks, nothing else.",
      "Numerals in Bahnschrift, UI in Segoe UI Variable.",
      "Hairline dividers (1px Line) instead of cards.",
      "Rounded corners only on interactive controls."
    ],
    "rules": [
      {
        "name": "The One Gold Rule",
        "body": "Gold means \"this is the count, the chosen thing, or the action\". Never use it for decoration, borders at rest, or icons in idle state.",
        "section": "colors"
      },
      {
        "name": "The Tinted Neutral Rule",
        "body": "Every neutral leans warm toward the gold; pure greys are not in the system.",
        "section": "colors"
      },
      {
        "name": "The Text Floor Rule",
        "body": "Text uses Text, Muted or Faint. Faint is the lowest text tier; Dim and Line are never text colours.",
        "section": "colors"
      },
      {
        "name": "The Numbers Are Bahnschrift Rule",
        "body": "Every count, average or score is set in Bahnschrift; never in Segoe UI.",
        "section": "typography"
      },
      {
        "name": "The Flat Ledger Rule",
        "body": "Group content with hairlines and spacing; never with drop shadows or boxed cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do lead every view with the number in Bahnschrift, gold only for the headline count.",
      "Do separate groups with 1px Line hairlines and the 28px gutter.",
      "Do show selection as Gold Wash fill plus Lit Gold text.",
      "Do colour non-plain openings by Fortnite rarity (rare purple, relic blue, buried bronze, poster green) and keep plain chests gold.",
      "Do ease animations out (exponential) and skip them when Windows UI effects are off."
    ],
    "donts": [
      "Don't build grids of equal stat cards with icon tiles; use the inline hairline ledger.",
      "Don't add drop shadows or raised cards.",
      "Don't round non-interactive containers.",
      "Don't use pure greys, or Dim/Line for any text.",
      "Don't spend gold on decoration or idle icons."
    ]
  }
}